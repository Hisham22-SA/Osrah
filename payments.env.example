# Configure these in the server environment. Never copy the secret key into Android.
# Start with the Tap test key (sk_test_...) and a public HTTPS deployment URL.
TAP_SECRET_KEY=sk_test_replace_with_your_test_key
OSRAH_PUBLIC_URL=https://your-public-domain.example

# Optional, mainly for isolated testing. Production default:
# TAP_API_URL=https://api.tap.company/v2
